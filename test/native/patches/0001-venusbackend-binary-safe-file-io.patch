+++ b/simulator/FileHandle.kt
@@ -0,0 +1,85 @@
+package venusbackend.simulator
+
+/**
+ * A byte oriented file handle.
+ *
+ * Both the VFS backed [FileDescriptor] and the host backed [HostFileDescriptor] implement this, so
+ * that ecalls 14/15 (`read`/`write`) move raw bytes instead of strings. Bytes in the range
+ * 0x00..0xff survive that trip unchanged.
+ */
+interface FileHandle {
+    /** Reads at most [size] bytes. `null` means nothing could be read (end of file, or denied). */
+    fun read(size: Int): ByteArray?
+
+    /** Appends [data]. Returns the number of bytes written, or [FilesHandler.EOF] on failure. */
+    fun write(data: ByteArray): Int
+
+    /** Flushes pending writes. Returns 0 on success, [FilesHandler.EOF] otherwise. */
+    fun flush(): Int
+
+    /** Closes the handle. Returns 0 on success, [FilesHandler.EOF] otherwise. */
+    fun close(): Int
+
+    /** Non-zero when the end of the stream has been reached, like C's `feof`. */
+    fun isEOF(): Int
+
+    /** Non-zero when an error occurred on the handle, like C's `ferror`. */
+    fun getError(): Int
+}
+
+/**
+ * A file handle for a real (host) file, used while host file mode is enabled.
+ *
+ * Reads come straight from the file through [HostFileSystem.readAt]; writes append and are not
+ * buffered. Appending matches the JVM reference implementation, whose descriptor keeps the whole
+ * file in a string builder and appends every write. No UTF-8 encoding is involved at any point.
+ *
+ * `feof`/`ferror` return 0, again like the JVM reference, whose flags are never raised: programs
+ * detect the end of a file from the [FilesHandler.EOF] result of `read`.
+ */
+class HostFileDescriptor(val path: String, private val fdID: Int, val permissions: Int) : FileHandle {
+    private val readable = permissions == 0 || permissions == 3 || permissions == 4 || permissions == 5
+    private val writeable = permissions == 1 || permissions == 2 || permissions == 3 ||
+            permissions == 4 || permissions == 5
+    private var readOffset = 0
+
+    override fun read(size: Int): ByteArray? {
+        if (!readable || size <= 0) {
+            return null
+        }
+        val data = HostFileSystem.readAt(fdID, size, readOffset)
+        if (data == null || data.isEmpty()) {
+            return null
+        }
+        readOffset += data.size
+        return data
+    }
+
+    override fun write(data: ByteArray): Int {
+        if (!writeable) {
+            return FilesHandler.EOF
+        }
+        val position = HostFileSystem.fileSize(fdID)
+        if (position < 0) {
+            return FilesHandler.EOF
+        }
+        return HostFileSystem.writeAt(fdID, data, position)
+    }
+
+    override fun flush(): Int {
+        // Host writes are not buffered, so there is nothing to push out here.
+        return 0
+    }
+
+    override fun close(): Int {
+        return if (HostFileSystem.closeFile(fdID)) 0 else FilesHandler.EOF
+    }
+
+    override fun isEOF(): Int {
+        return 0
+    }
+
+    override fun getError(): Int {
+        return 0
+    }
+}
