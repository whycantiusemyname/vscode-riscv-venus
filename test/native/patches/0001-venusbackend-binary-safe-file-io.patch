diff --git a/simulator/HostFileSystem.kt b/simulator/HostFileSystem.kt
new file mode 100644
index 0000000..ca9f78c
--- /dev/null
+++ b/simulator/HostFileSystem.kt
@@ -0,0 +1,247 @@
+package venusbackend.simulator
+
+/**
+ * Host filesystem bridge for the native (Node.js) Venus backend.
+ *
+ * The Venus core is built for two very different hosts:
+ *
+ *  * the browser, where the file system is the in-memory `venus.vfs.VirtualFileSystem` and the
+ *    only persistence is `localStorage`;
+ *  * Node.js (the native VS Code debugger), where the programs under test read and write real
+ *    files such as the Project 2 input matrices.
+ *
+ * All Node `fs` usage lives here, so that the browser build never loads it: the module is
+ * required lazily and only host mode has been enabled explicitly through [enable]. Host mode is
+ * off by default, which keeps the legacy VFS/browser code path unchanged.
+ *
+ * Contents are handled as bytes: bytes in the range 0x00..0xff are passed through verbatim
+ * instead of being routed through a UTF-8 encode/decode round trip. This mirrors the JVM
+ * reference implementation, which maps a `java.io.File` onto a VFS file byte by byte.
+ *
+ * The embedding application configures this through the `venus.Driver` JS API:
+ *
+ * ```
+ * venus.Driver.setHostFileCwd(process.cwd())
+ * venus.Driver.enableHostFileIO(true)
+ * ```
+ */
+object HostFileSystem {
+    /** Directory used to resolve relative paths. Empty means "ask the process". */
+    var workingDirectory: String = ""
+        private set
+
+    private var hostEnabled = false
+    private var fsProbed = false
+    private var nodeFs: dynamic = null
+
+    /** Turns the host file backend on or off. Off by default, so browser backends keep the VFS. */
+    fun enable(enabled: Boolean) {
+        hostEnabled = enabled
+    }
+
+    /** True when the embedding asked for host files and a Node `fs` module is available. */
+    fun isEnabled(): Boolean {
+        return hostEnabled && fs() != null
+    }
+
+    /** Sets the directory that relative paths are resolved against. */
+    fun setWorkingDirectory(path: String) {
+        workingDirectory = path.replace('\\', '/').trimEnd('/')
+    }
+
+    /**
+     * Resolves [path] to a host path: absolute paths (POSIX, Windows drive and UNC) are used as
+     * given, everything else is resolved against the configured working directory.
+     */
+    fun resolve(path: String): String {
+        val cleaned = path.replace('\\', '/')
+        if (isAbsolute(cleaned)) {
+            return cleaned
+        }
+        val base = baseDirectory()
+        return if (base.isEmpty()) cleaned else base + "/" + cleaned
+    }
+
+    /**
+     * Resolves [path] to an existing host file, or `null` when there is none.
+     *
+     * VFS paths of files that live directly under the root, such as `/main.s`, are also tried
+     * relative to the working directory, because the VFS tree prefixes them with a separator.
+     */
+    fun resolveExisting(path: String): String? {
+        val cleaned = path.replace('\\', '/')
+        val direct = resolve(cleaned)
+        if (isFile(direct)) {
+            return direct
+        }
+        val withoutRoot = cleaned.trimStart('/')
+        if (withoutRoot != cleaned) {
+            val relative = resolve(withoutRoot)
+            if (relative != direct && isFile(relative)) {
+                return relative
+            }
+        }
+        return null
+    }
+
+    /** True when [path] names an existing regular file. */
+    fun isFile(path: String): Boolean {
+        val fsModule = fs() ?: return false
+        return try {
+            fsModule.statSync(path).isFile() as Boolean
+        } catch (e: dynamic) {
+            false
+        }
+    }
+
+    /** Reads the whole file. Returns `null` when it cannot be read. */
+    fun readBytes(path: String): ByteArray? {
+        val fsModule = fs() ?: return null
+        return try {
+            val fd = fsModule.openSync(path, "r") as Int
+            try {
+                readFully(fd, fileSize(fd), 0)
+            } finally {
+                fsModule.closeSync(fd)
+            }
+        } catch (e: dynamic) {
+            null
+        }
+    }
+
+    /**
+     * Reads the whole file as text with a 1:1 byte/char mapping (latin-1). This mirrors the JVM
+     * reference implementation, which reads the bytes of a `java.io.File` into a string of chars
+     * `byte and 0xff`: no UTF-8 decoding happens, so no byte is lost or replaced.
+     */
+    fun readText(path: String): String? {
+        val bytes = readBytes(path) ?: return null
+        val sb = StringBuilder(bytes.size)
+        for (b in bytes) {
+            sb.append((b.toInt() and 0xFF).toChar())
+        }
+        return sb.toString()
+    }
+
+    /** Opens a host file with a Node flag string (`r`, `w`, `a`, `r+`, `w+`, `a+`). */
+    fun openFile(path: String, flags: String): Int {
+        val fsModule = fs() ?: return FilesHandler.EOF
+        return try {
+            val fd = fsModule.openSync(path, flags) as Int
+            // POSIX lets a directory be opened read-only, but the JVM reference implementation
+            // only ever maps a regular file onto a descriptor, so anything else counts as a
+            // failed open on every platform. The probe is closed again so the descriptor table
+            // stays clean either way.
+            if (fsModule.fstatSync(fd).isFile() as Boolean) {
+                fd
+            } else {
+                fsModule.closeSync(fd)
+                FilesHandler.EOF
+            }
+        } catch (e: dynamic) {
+            FilesHandler.EOF
+        }
+    }
+
+    /** Closes a host file descriptor. */
+    fun closeFile(fd: Int): Boolean {
+        val fsModule = fs() ?: return false
+        return try {
+            fsModule.closeSync(fd)
+            true
+        } catch (e: dynamic) {
+            false
+        }
+    }
+
+    /** Size of an open file in bytes, or -1 when it cannot be determined. */
+    fun fileSize(fd: Int): Int {
+        val fsModule = fs() ?: return -1
+        return try {
+            (fsModule.fstatSync(fd).size as Number).toInt()
+        } catch (e: dynamic) {
+            -1
+        }
+    }
+
+    /**
+     * Reads up to [size] bytes starting at [position]. Returns the bytes that were read (fewer
+     * than [size] at end of file), or `null` when the read failed.
+     */
+    fun readAt(fd: Int, size: Int, position: Int): ByteArray? {
+        if (size < 0) {
+            return null
+        }
+        return readFully(fd, size, position)
+    }
+
+    /** Writes [data] at [position]. Returns the number of bytes written, or [FilesHandler.EOF]. */
+    fun writeAt(fd: Int, data: ByteArray, position: Int): Int {
+        val fsModule = fs() ?: return FilesHandler.EOF
+        return try {
+            fsModule.writeSync(fd, data, 0, data.size, position) as Int
+        } catch (e: dynamic) {
+            FilesHandler.EOF
+        }
+    }
+
+    private fun readFully(fd: Int, size: Int, position: Int): ByteArray? {
+        if (size <= 0) {
+            return ByteArray(0)
+        }
+        val buffer = ByteArray(size)
+        var offset = 0
+        while (offset < size) {
+            val read = readInto(fd, buffer, offset, size - offset, position + offset) ?: return null
+            if (read <= 0) {
+                break
+            }
+            offset += read
+        }
+        return if (offset == size) buffer else buffer.copyOf(offset)
+    }
+
+    private fun readInto(fd: Int, buffer: ByteArray, offset: Int, length: Int, position: Int): Int? {
+        val fsModule = fs() ?: return null
+        return try {
+            fsModule.readSync(fd, buffer, offset, length, position) as Int
+        } catch (e: dynamic) {
+            null
+        }
+    }
+
+    private fun isAbsolute(path: String): Boolean {
+        return path.startsWith("/") || path.matches(Regex("[A-Za-z]:.*"))
+    }
+
+    private fun baseDirectory(): String {
+        if (workingDirectory.isNotEmpty()) {
+            return workingDirectory
+        }
+        return processCwd()
+    }
+
+    private fun processCwd(): String {
+        return try {
+            js("(typeof process === 'object' && process.cwd) ? process.cwd().replace(/\\\\/g, '/') : ''") as String
+        } catch (e: dynamic) {
+            ""
+        }
+    }
+
+    /**
+     * Lazily requires Node's `fs`. Nothing is loaded at module scope, so browser builds stay
+     * unchanged: they simply never enable host mode.
+     */
+    private fun fs(): dynamic {
+        if (!fsProbed) {
+            fsProbed = true
+            nodeFs = try {
+                js("(typeof require === 'function') ? require('fs') : null")
+            } catch (e: dynamic) {
+                null
+            }
+        }
+        return nodeFs
+    }
+}
