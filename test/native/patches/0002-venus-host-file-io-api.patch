+    /**
+     * Enables the host file backend. While enabled, ecalls 13/14/15/16 read and write real
+     * files (within the configured working directory) instead of files in the in-memory VFS,
+     * and `.import` resolves through the real filesystem. Off by default, so browser backends
+     * keep using the VFS alone.
+     */
+    @JsName("enableHostFileIO") fun enableHostFileIO(enabled: Boolean) {
+        HostFileSystem.enable(enabled)
+    }
+
+    /**
+     * Sets the directory that relative host file paths are resolved against, typically the
+     * workspace or launch directory of the debug session.
+     */
+    @JsName("setHostFileCwd") fun setHostFileCwd(cwd: String) {
+        HostFileSystem.setWorkingDirectory(cwd)
+    }
+
+    /** True while host file mode is enabled and Node's fs module is available. */
+    @JsName("isHostFileIOEnabled") fun isHostFileIOEnabled(): Boolean {
+        return HostFileSystem.isEnabled()
+    }
